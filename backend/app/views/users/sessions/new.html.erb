<div class="d-flex h-100 text-center text-white bg-dark">
  <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
    <header class="mb-auto">
      <div>
        <h3 class="float-md-start mb-0">App Name</h3>
        <nav class="nav nav-masthead justify-content-center float-md-end">
          <% if user_signed_in? %>
            <a class="nav-link active" href="<%= destroy_user_session_path %>" data-method="delete">Logout</a>
          <% else %>
            <a class="nav-link" href="<%= new_user_session_path %>">Login</a>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="px-3">
      <h1>Login to Your Account</h1>
      <%= form_with model: resource, as: resource_name, url: session_path(resource_name), local: true, class: "form-signin" do |f| %>
        <div class="form-group">
          <%= f.email_field :email, autofocus: true, class: "form-control", placeholder: "Email", required: true %>
        </div>
        <div class="form-group">
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Password", required: true %>
        </div>
        <div>
          <%= f.submit "Log in", class: "btn btn-lg btn-primary btn-block" %>
        </div>
      <% end %>
      <div class="mt-3">
        <p class="text-white-50">Don't have an account? <a href="<%= new_user_registration_path %>" class="text-primary">Sign up</a></p>
      </div>
    </main>

    <footer class="mt-auto text-white-50">
      <p>Powered by <a href="https://getbootstrap.com/" class="text-white">Bootstrap</a>.</p>
    </footer>
  </div>
</div>
